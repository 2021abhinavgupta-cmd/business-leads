# Copy this file to .env and fill in real values. Never commit .env.

# === AI API Keys (at least one required — fallback chain: Anthropic -> Gemini -> OpenAI -> OpenRouter) ===
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free-tier fallback, no credit card required: sign up at openrouter.ai.
# Only used if the three paid providers above all fail or run out of quota.
OPENROUTER_API_KEY=

# === Email transport ===
# Which transport delivers the mail: "ses" (default) or "gmail".
# "gmail" sends through an authenticated Google Workspace mailbox over SMTP —
# better inbox placement for Gmail recipients, but Google suspends accounts
# that send bulk unsolicited mail, so keep GMAIL_DAILY_CAP low and point it at
# a throwaway domain, never the domain carrying real client correspondence.
EMAIL_PROVIDER=ses

# === AWS Credentials (used when EMAIL_PROVIDER=ses) ===
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
FROM_EMAIL=

# === Google Workspace mailbox (used when EMAIL_PROVIDER=gmail) ===
# GMAIL_APP_PASSWORD is an App Password from
# https://myaccount.google.com/apppasswords — NOT the account password.
# Creating one requires 2-Step Verification to be enabled on the account.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Self-imposed daily ceiling. Google's own limit is far higher (2,000 external
# recipients/day on Workspace); this cap exists to avoid suspension, not to
# avoid the hard limit.
GMAIL_DAILY_CAP=40
# Public base URL of this deployment (e.g. https://myapp.up.railway.app), used
# to build a one-click unsubscribe link in the List-Unsubscribe header. Blank
# is fine (falls back to a mailto: unsubscribe link) but hurts deliverability
# with Gmail/Yahoo's bulk-sender rules.
APP_BASE_URL=

# === Google Sheets (legacy CRM) ===
GOOGLE_SHEETS_ID=
# Prefer this in production (Railway); local dev falls back to a credentials.json file in repo root.
GOOGLE_CREDENTIALS_JSON=

# === Scraper API Keys ===
GOOGLE_MAPS_API_KEY=
PAGESPEED_KEY=
APOLLO_API_KEY=

# === Instagram Credentials ===
IG_USERNAME=
IG_PASSWORD=

# === Limits & Settings ===
DAILY_EMAIL_LIMIT=100
# Options: maps, ecommerce, startups, b2b
LEAD_SOURCE=maps

# === Outreach ===
# Sender display name used to sign outreach emails (not read via config.py, read directly via os.getenv)
YOUR_NAME=

# === API Auth ===
# Required X-API-Key header value for all /api/* routes. If left blank, the API
# is unauthenticated (fine for local dev, NOT fine once deployed publicly).
# Set the same value in frontend/.env as VITE_API_KEY so the frontend can call the API.
API_KEY=

